{
  "name": "tally-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic event-sourced ledger, audited decisions and conservative reconciliation",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src tests scripts && prettier --check src tests scripts",
    "format": "prettier --write src tests scripts",
    "test": "node --test --test-concurrency=1 dist/tests/*.test.js",
    "start": "node dist/src/main.js",
    "migrate": "node dist/scripts/migrate.js",
    "seed": "node dist/scripts/seed.js",
    "bench": "node dist/scripts/bench.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "type": "module"
}
